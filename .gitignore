# Ignore everything
*
**

# Repository metadata and top-level files
!.gitignore
!.gitattributes
!README.md
!LICENSE
!pyproject.toml
!build_info.json

# GitHub Actions
!.github/
!.github/workflows/
!.github/workflows/docs.yml

# Documentation
!docs/
!docs/conf.py
!docs/index.md

# Documentation PDF page
!docs/pdf/
!docs/pdf/index.md

# LaTeX report
!docs/report/
!docs/report/main.tex
!docs/report/references.bib
!docs/report/figures/
!docs/report/figures/.gitkeep
!docs/report/sections/
!docs/report/sections/*.tex

# Generated research report
!report/
!report/*.pdf

# Python package
!src/
!src/granular_rves/
!src/granular_rves/__init__.py
# Python package
!src/
!src/granular_rves/
!src/granular_rves/__init__.py

!src/granular_rves/materials/
!src/granular_rves/materials/*.py

!src/granular_rves/mechanics/
!src/granular_rves/mechanics/*.py

!src/granular_rves/geometry/
!src/granular_rves/geometry/*.py

!src/granular_rves/boundary/
!src/granular_rves/boundary/*.py

!src/granular_rves/loading/
!src/granular_rves/loading/*.py

!src/granular_rves/solvers/
!src/granular_rves/solvers/*.py

!src/granular_rves/output/
!src/granular_rves/output/*.py

# Python tooling
!scripts/
!scripts/*.py

# Tests
!tests/
!tests/*.py
